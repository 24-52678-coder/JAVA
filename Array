public class Array {
    public static void main(String[] args) {
        String[] carBrands = {"Toyota", "Honda", "Mercedes-Benz", "BMW", "Ford"};

        System.out.println("List of Car Brands:");
        for (int i = 0; i < carBrands.length; i++) {
            System.out.println((i + 1) + ". " + carBrands[i]);
        }

        System.out.println("\nMy favorite brand is: " + carBrands[2]);
    }
}
